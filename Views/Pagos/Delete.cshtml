@model Pago
@{
    ViewData["Title"] = "Anular pago";
}

<h4>¿Anular este pago?</h4>
<p class="text-muted">El pago no se borra: queda registrado pero marcado como anulado, tal como pide la consigna.</p>
<hr />
<dl class="row">
    <dt class="col-sm-2">Concepto</dt>
    <dd class="col-sm-10">@Model.Concepto</dd>
    <dt class="col-sm-2">Monto</dt>
    <dd class="col-sm-10">@Model.Monto.ToString("C")</dd>
    <dt class="col-sm-2">Fecha</dt>
    <dd class="col-sm-10">@Model.Fecha.ToShortDateString()</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" name="id" value="@Model.IdPago" />
    <input type="hidden" name="idReserva" value="@Model.IdReserva" />
    <input type="submit" value="Confirmar anulación" class="btn btn-danger" /> |
    <a asp-action="Index" asp-route-idReserva="@Model.IdReserva">Cancelar</a>
</form>
