@model List<Inmueble>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Inmuebles";
}

<h1>Inmuebles</h1>
<a asp-action="Create" class="btn btn-primary">Nuevo</a>
@if (ViewBag.IdPropietario != null)
{
    <div class="alert alert-info">
        Mostrando inmuebles de: <strong>@ViewBag.NombrePropietario</strong>
        <a asp-action="Index" class="float-end">Ver todos</a>
    </div>
}
<a  asp-controller="Informes" asp-action="MasReservados" class="btn btn-sm btn-outline-secondary">Inmuebles más reservados en los ultimos 365 dias</a>
<a  asp-controller="Informes" asp-action="SinReservas" class="btn btn-sm btn-outline-secondary">Inmuebles sin reservas en los ultimos X dias</a>
<form method="get" class="form-inline mb-3">
    <select name="disponible" class="form-control" onchange="this.form.submit()">
        <option value="">-- Todos --</option>
        <option value="true" selected="@(ViewBag.Disponible == true)">Disponibles</option>
        <option value="false" selected="@(ViewBag.Disponible == false)">No disponibles</option>
    </select>
</form>
<table class="table">
    <thead>
        <tr>
            <th>Dirección</th>
            <th>Propietario</th>
            <th>Tipo</th>
            <th>m²</th>
            <th>Habitaciones</th>
            <th>Porcentaje de Seña</th>
            <th>Disponible</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var i in Model)
    {
        <tr>
            <td>@i.Direccion</td>
            <td>@i.NombrePropietario</td>
            <td>@i.NombreTipoInmueble</td>
            <td>@i.Metros_Cuadrados</td>
            <td>@i.Habitaciones</td>
            <td>@i.Porcentaje_Sena.ToString("0.##")%</td>
            <td>@(i.Disponible ? "Sí" : "No")</td>
            <td>
                <a asp-action="Details" asp-route-id="@i.IdInmueble" class="btn btn-sm btn-outline-secondary">Detalles</a>
                <a asp-action="Edit" asp-route-id="@i.IdInmueble" class="btn btn-sm btn-outline-primary">Editar</a>
                @if (User.IsInRole("Administrador")) {
                    <a asp-action="Delete" asp-route-id="@i.IdInmueble" class="btn btn-sm btn-outline-danger">Eliminar</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
