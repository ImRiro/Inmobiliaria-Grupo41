@model Inmueble

@{
    ViewData["Title"] = "Detalle del inmueble";
}

<h1>Detalle del inmueble</h1>
<div>
    <dl class="row">
        @if (!string.IsNullOrEmpty(Model.RutaPortada))
        {
            <img src="@Model.RutaPortada" style="max-width:100%;max-height:300px;object-fit:cover" class="rounded mb-3" />
        }
        
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.IdInmueble</dd>

        <dt class="col-sm-3">Dirección</dt>
        <dd class="col-sm-9">@Model.Direccion</dd>

        <dt class="col-sm-3">Propietario</dt>
        <dd class="col-sm-9">@Model.NombrePropietario</dd>

        <dt class="col-sm-3">Tipo de inmueble</dt>
        <dd class="col-sm-9">@Model.NombreTipoInmueble</dd>

        <dt class="col-sm-3">Metros cuadrados</dt>
        <dd class="col-sm-9">@Model.Metros_Cuadrados</dd>

        <dt class="col-sm-3">Habitaciones</dt>
        <dd class="col-sm-9">@Model.Habitaciones</dd>

        <dt class="col-sm-3">Latitud</dt>
        <dd class="col-sm-9">@(Model.Latitud.ToString() ?? "-")</dd>

        <dt class="col-sm-3">Longitud</dt>
        <dd class="col-sm-9">@(Model.Longitud.ToString() ?? "-")</dd>

        <dt class="col-sm-3">Porcentaje de Seña</dt>
        <dd class="col-sm-9">@Model.Porcentaje_Sena.ToString("0.##")%</dd>

        <dt class="col-sm-3">Imágenes</dt>
        <dd class="col-sm-9">
            <a asp-action="Imagenes" asp-route-id="@Model.IdInmueble" class="btn btn-sm btn-outline-secondary">Ver imágenes</a>
        </dd>

        <dt class="col-sm-3">Disponible</dt>
        <dd class="col-sm-9">@(Model.Disponible ? "Sí" : "No")</dd>
    </dl>

    <a asp-action="Edit" asp-route-id="@Model.IdInmueble" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>
