@model List<TipoInmueble>

@{
    ViewData["Title"] = "Tipos de Inmueble";
}

<h1>Tipos de Inmueble</h1>
<a asp-action="Create" class="btn btn-primary">Nuevo</a>
<table class="table">
    <thead><tr><th>Nombre</th><th></th></tr></thead>
    <tbody>
    @foreach (var t in Model)
    {
        <tr>
            <td>@t.Nombre</td>
            <td>
                <a asp-action="Details" asp-route-id="@t.IdTipoInmueble" class="btn btn-sm btn-outline-secondary">Detalles</a>
                <a asp-action="Edit" asp-route-id="@t.IdTipoInmueble" class="btn btn-sm btn-outline-primary">Editar</a>
                <a asp-action="Delete" asp-route-id="@t.IdTipoInmueble" class="btn btn-sm btn-outline-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
