@model List<Propietario>
<h1>Propietarios</h1>
<a asp-action="Create" class="btn btn-primary">Nuevo</a>
<table class="table">
    <thead><tr><th>Nombre</th><th>Contacto</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.DNI</td>
            <td>@p.Nombre</td>
            <td>@p.Apellido</td>
            <td>@p.Email</td>
            <td>
                <a asp-action="Edit" asp-route-id="@p.IdPropietario">Editar</a> |
                <a asp-action="Delete" asp-route-id="@p.IdPropietario">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>