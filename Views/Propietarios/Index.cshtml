@using Inmobiliaria_.Net_Core.Models
@model PaginadoViewModel<Propietario>

<h1>Propietarios</h1>
<a asp-action="Create" class="btn btn-primary">Nuevo</a>
<table class="table">
    <thead><tr><th>Nombre</th><th>Contacto</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model.Elementos)
    {
        <tr>
            <td>@p.DNI</td>
            <td>@p.Nombre</td>
            <td>@p.Apellido</td>
            <td>@p.Email</td>
            <td>
                <a asp-action="Edit" asp-route-id="@p.IdPropietario" class="btn btn-sm btn-outline-primary">Editar</a>
                @if (User.IsInRole("Administrador")) {
                    <a asp-action="Delete" asp-route-id="@p.IdPropietario" class="btn btn-sm btn-outline-danger">Eliminar</a>
                }
                <a asp-controller="Inmuebles" asp-action="Index" asp-route-idPropietario="@p.IdPropietario" class="btn btn-sm btn-outline-secondary">Ver inmuebles</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<vc:paginacion pagina-actual="@Model.PaginaActual"
               total-paginas="@Model.TotalPaginas"
               tamano-pagina="@Model.TamanoPagina"
               action-name="Index"
               controller-name="Propietarios" />