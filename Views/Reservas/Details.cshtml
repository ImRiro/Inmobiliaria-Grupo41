@model Reserva

@{
    ViewData["Title"] = "Detalle de la reserva";
}

<h1>Detalle de la reserva</h1>
<div>
    <dl class="row">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.IdReserva</dd>

        <dt class="col-sm-3">Inmueble</dt>
        <dd class="col-sm-9">@Model.DireccionInmueble</dd>

        <dt class="col-sm-3">Inquilino</dt>
        <dd class="col-sm-9">@Model.NombreInquilino</dd>

        <dt class="col-sm-3">Fecha desde</dt>
        <dd class="col-sm-9">@Model.Fecha_Desde.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Fecha hasta</dt>
        <dd class="col-sm-9">@Model.Fecha_Hasta.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Fecha de cancelación</dt>
        <dd class="col-sm-9">@(Model.Fecha_Cancelacion.HasValue ? Model.Fecha_Cancelacion.Value.ToString("dd/MM/yyyy") : "-")</dd>

        <dt class="col-sm-3">Monto por día</dt>
        <dd class="col-sm-9">@Model.Monto_Diario.ToString("C")</dd>

        <dt class="col-sm-3">Costo total</dt>
        <dd class="col-sm-9">@Model.Costo_Total.ToString("C")</dd>
    </dl>

    <a asp-action="Edit" asp-route-id="@Model.IdReserva" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>
