@model List<ReservaVigente>

@{
    ViewData["Title"] = "Reservas Vigentes";
}

<h1>Reservas Vigentes</h1>

@if (Model.Count == 0)
{
    <p>No hay reservas vigentes actualmente.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Inmueble</th>
                <th>Inquilino</th>
                <th>Fecha Desde</th>
                <th>Fecha Hasta</th>
                <th>Monto Diario</th>
                <th>Costo Total</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var reserva in Model)
            {
                <tr>
                    <td>@reserva.DireccionInmueble</td>
                    <td>@reserva.NombreInquilino</td>
                    <td>@reserva.Fecha_Desde.ToString("dd/MM/yyyy")</td>
                    <td>@reserva.Fecha_Hasta.ToString("dd/MM/yyyy")</td>
                    <td>@reserva.Monto_Diario.ToString("C")</td>
                    <td>@reserva.Costo_Total.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}
