@model List<ReservaPorVencer>

@{
    ViewData["Title"] = "Reservas por vencer";
}

<h1>Reservas por vencer</h1>

<form asp-action="TerminanEn" method="get" class="mb-4">

    <label for="dias">Mostrar reservas que terminan dentro de:</label>

    <input type="number"
        id="dias"
        name="dias"
        min="1"
        value="@ViewBag.Dias" />

    <span>días</span>

    <button type="submit" class="btn btn-primary">
        Buscar
    </button>

</form>

@if (Model.Count == 0)
{
    <p>
        No hay reservas que terminen dentro de los próximos
        @ViewBag.Dias días.
    </p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Inmueble</th>
                <th>Inquilino</th>
                <th>Fecha Desde</th>
                <th>Fecha Hasta</th>
                <th>Monto Diario</th>
                <th>Costo Total</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var reserva in Model)
            {
                <tr>
                    <td>@reserva.DireccionInmueble</td>
                    <td>@reserva.NombreInquilino</td>
                    <td>@reserva.Fecha_Desde.ToString("dd/MM/yyyy")</td>
                    <td>@reserva.Fecha_Hasta.ToString("dd/MM/yyyy")</td>
                    <td>@reserva.Monto_Diario.ToString("C")</td>
                    <td>@reserva.Costo_Total.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}